{
  "name": "ar-io-proof-checker",
  "version": "0.1.0",
  "description": "Reverse-provenance checker — drop a file in, discover its on-chain ar.io provenance. Client-side, zero-upload, auditor-independent.",
  "license": "BUSL-1.1",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:proof": "npm run build -w @ar.io/proof",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ar.io/proof": "*",
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "happy-dom": "^20.9.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^2.0.0"
  }
}
